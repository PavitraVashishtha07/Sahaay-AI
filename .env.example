# Sahaay AI Environment Configuration Template
# Copy this file to .env and fill in your actual credentials (never commit .env)

# Google Gemini API Key for Multilingual Intent Extraction
# Get yours for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Variant (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Fast timeout before falling back to deterministic regex extraction (seconds)
GEMINI_TIMEOUT_SECONDS=3.5

# CORS Allowed Origins (comma-separated or * for wildcard)
ALLOWED_ORIGINS=*

# Server Port (automatically set by Render/Railway)
PORT=8000
